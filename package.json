{
  "name": "cravings-desktop",
  "version": "1.6.15",
  "description": "Desktop application for Cravings.live",
  "homepage": "https://www.cravings.live",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win",
    "ship": "electron-builder --win --publish always",
    "build:win": "electron-builder --win",
    "build:win7": "electron-builder --config electron-builder-win7.js",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "author": "NoTime <notimeservices@gmail.com>",
  "license": "ISC",
  "build": {
    "appId": "live.cravings.desktop",
    "productName": "Menuthere",
    "publish": {
      "provider": "github",
      "owner": "ab-h-i-n",
      "repo": "cravings-software"
    },
    "files": [
      "main.js",
      "preload.js",
      "arabicLabels.js",
      "billInvoice.js",
      "billInvoiceUae.js",
      "deliveryBoyBlock.js",
      "billTemplate.js",
      "starGraphic.js",
      "designer.html",
      "designer-preload.js",
      "update.html",
      "update-preload.js",
      "rebrand.html",
      "settings.html",
      "settings-preload.js",
      "test-receipt.html",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "./print-raw.exe",
        "to": "print-raw.exe"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Cravings.live"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "maintainer": "NoTime <notimeservices@gmail.com>"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Menuthere",
      "uninstallDisplayName": "Menuthere",
      "artifactName": "Menuthere-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-log": "^5.1.5",
    "electron-updater": "^6.1.8"
  }
}
